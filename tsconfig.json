{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@zaliel/core": ["packages/core/src/index.ts"],
      "@zaliel/renderer": ["packages/renderer/src/index.ts"],
      "@zaliel/editor": ["packages/editor/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "apps/desktop/src", "apps/desktop/electron.vite.config.ts"]
}
